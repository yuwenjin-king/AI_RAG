# ===== 应用 =====
APP_NAME=enterprise-rag
ENV=dev
LOG_LEVEL=INFO
# 默认租户（X-Tenant-Id 缺省时回退到此值）
DEFAULT_TENANT_ID=default
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== PostgreSQL（元数据） =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=rag
DATABASE_URL=postgresql+asyncpg://rag:ragpass@postgres:5432/rag

# ===== Milvus（向量库） =====
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_ENABLED=true
# 默认 embedding 维度（需与所选 Embedding 模型一致）
EMBEDDING_DIM=1024

# ===== OpenSearch（BM25 倒排） =====
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_ENABLED=true

# ===== Redis（缓存/会话） =====
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# ===== Kafka（异步管道） =====
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_INGEST_TOPIC=rag.ingest
KAFKA_CONSUMER_GROUP=rag-ingest-worker

# ===== MinIO（对象存储） =====
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents
MINIO_SECURE=false

# ===== LLM（生成，OpenAI 兼容；可指向 GLM/Qwen/DeepSeek/OpenAI/Anthropic 兼容网关） =====
# 不填则降级到内置 mock（空跑可用，但不产生真实 AI 输出）
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_TIMEOUT=60

# ===== Embedding（向量化，OpenAI 兼容） =====
# 不填则降级到内置哈希占位向量（仅用于跑通链路，无真实语义）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3

# ===== Rerank（Cross-Encoder 精排，可选） =====
# 不填则跳过精排
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=

# ===== PDF 视觉解析（设计书 §4.2.2，可选；扫描件/复杂排版） =====
# 总开关关闭 → 扫描件走纯文本兜底（可能无文本）。启用需装 pymupdf(+ultralytics/paddleocr)
VISION_ENABLED=false
PDF_LAYOUT_DETECTOR=auto          # auto | pymupdf | yolo
YOLO_MODEL_PATH=                  # DocLayout-YOLO 权重路径（yolo 模式必填）
OCR_ENGINE=none                   # none | paddle
EMBEDDING_PROVIDER=auto           # auto | openai_compatible | sentence_transformers | mock
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5

# ===== 检索参数 =====
RETRIEVAL_VECTOR_TOPK=50
RETRIEVAL_KEYWORD_TOPK=50
RETRIEVAL_FINAL_TOPK=8
RRF_K=60

# ===== 请求头 =====
# 租户头名
TENANT_HEADER=X-Tenant-Id
ROLE_HEADER=X-Role

# ===== RBAC（设计书 §6/§8） =====
RBAC_ENABLED=true
# JSON 策略，如 {"allowed_kb_ids":[1,2]} ；运行时可被场景/角色规则覆盖
RBAC_POLICY=

# ===== 成本管控（缓存/限流，设计书 §4.5/§2.2） =====
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL=86400
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL=60
# /chat per-tenant 每分钟限流；0=不限
RATE_LIMIT_CHAT_PER_MIN=60
