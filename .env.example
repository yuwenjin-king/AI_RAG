# ===== 应用 =====
APP_NAME=enterprise-rag
ENV=dev
LOG_LEVEL=INFO
# 默认租户（X-Tenant-Id 缺省时回退到此值）
DEFAULT_TENANT_ID=default
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== PostgreSQL（元数据） =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=rag
DATABASE_URL=postgresql+asyncpg://rag:ragpass@postgres:5432/rag

# ===== Milvus（向量库） =====
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_ENABLED=true
# 默认 embedding 维度（需与所选 Embedding 模型一致）
EMBEDDING_DIM=1024
# 大租户独立 collection（否则共享 + tenant_id 过滤）
COLLECTION_PER_TENANT=false
# HNSW 索引参数（召回率/延迟权衡）
HNSW_M=16
HNSW_EF_CONSTRUCTION=256
HNSW_EF_SEARCH=128

# ===== OpenSearch（BM25 倒排） =====
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_ENABLED=true

# ===== Redis（缓存/会话） =====
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# ===== Kafka（异步管道） =====
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_INGEST_TOPIC=rag.ingest
KAFKA_CONSUMER_GROUP=rag-ingest-worker

# ===== MinIO（对象存储） =====
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents
MINIO_SECURE=false

# ===== LLM（生成，OpenAI 兼容；可指向 GLM/Qwen/DeepSeek/OpenAI/Anthropic 兼容网关） =====
# 不填则降级到内置 mock（空跑可用，但不产生真实 AI 输出）
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_TIMEOUT=60

# ===== Embedding（向量化，OpenAI 兼容） =====
# 不填则降级到内置哈希占位向量（仅用于跑通链路，无真实语义）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3

# ===== Rerank（Cross-Encoder 精排，可选） =====
# 不填则跳过精排
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=

# ===== PDF 视觉解析（设计书 §4.2.2，可选；扫描件/复杂排版） =====
# 总开关关闭 → 扫描件走纯文本兜底（可能无文本）。启用需装 pymupdf(+ultralytics/paddleocr)
VISION_ENABLED=false
PDF_LAYOUT_DETECTOR=auto          # auto | pymupdf | yolo
YOLO_MODEL_PATH=                  # DocLayout-YOLO 权重路径（yolo 模式必填）
OCR_ENGINE=none                   # none | paddle
EMBEDDING_PROVIDER=auto           # auto | openai_compatible | sentence_transformers | mock
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5

# ===== GraphRAG（设计书 §4.3/§4.4，P2） =====
GRAPH_ENABLED=false               # 图召回总开关（需 ingest 抽实体入图）
GRAPH_EXTRACTION=auto             # auto | llm | heuristic
NEO4J_URL=                        # 为空 → 内存图兜底（开发/测试）
NEO4J_USER=
NEO4J_PASSWORD=
GRAPH_RECALL_TOPK=30

# ===== CDC（设计书 §4.1，P2） =====
KAFKA_CDC_TOPIC=rag.cdc
KAFKA_CDC_GROUP=rag-cdc-worker

# ===== 检索参数 =====
RETRIEVAL_VECTOR_TOPK=50
RETRIEVAL_KEYWORD_TOPK=50
RETRIEVAL_FINAL_TOPK=8
RRF_K=60

# ===== 请求头 =====
# 租户头名
TENANT_HEADER=X-Tenant-Id
ROLE_HEADER=X-Role

# ===== RBAC（设计书 §6/§8） =====
RBAC_ENABLED=true
# JSON 策略，如 {"allowed_kb_ids":[1,2]} ；运行时可被场景/角色规则覆盖
RBAC_POLICY=

# ===== 认证授权（plan_three §1） =====
# false=信任 X-Tenant-Id/X-Role 头（本地/测试无密码可跑，默认）
# true =强制 Authorization: Bearer <JWT>，租户取自令牌（不可伪造）；启用前需 `make migrate && make seed-admin`
AUTH_ENABLED=false
# 生产务必覆盖为强随机串；轮换 secret 会使所有已签发 token 失效（等价于强制全量重新登录）
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# 首次 seed 管理员账号（仅 `make seed-admin` 读取；生产务必覆盖）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme

# ===== 成本管控（缓存/限流，设计书 §4.5/§2.2） =====
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL=86400
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL=60
# /chat per-tenant 每分钟限流；0=不限
RATE_LIMIT_CHAT_PER_MIN=60

# ===== Agentic RAG（plan_three §2）=====
# 总开关：关闭=单次 retrieve→generate；开启=充分性评估+迭代召回+答案自检
AGENTIC_ENABLED=false
AGENTIC_MAX_ITERATIONS=2           # 迭代轮数上限（含首次检索）
AGENTIC_SUFFICIENT_TOPK=3          # 启发式充分性：达此 chunk 数视为证据充分
AGENTIC_SELFCHECK_ENABLED=true     # 生成后答案 faithfulness 自检（需真实 LLM）

# ===== OpenTelemetry 分布式追踪（plan_three §3）=====
# 未装 opentelemetry → 自动降级 no-op。启用：make up-otel + OTEL_ENABLED=true + OTEL_EXPORTER=otlp
OTEL_ENABLED=false
OTEL_EXPORTER=console            # console | otlp
OTEL_ENDPOINT=http://localhost:4318/v1/traces   # 容器内用 http://jaeger:4318/v1/traces
OTEL_SERVICE_NAME=enterprise-rag

# ===== 韧性（plan_three §5）=====
# 外部调用（LLM/embedding）瞬时错误重试 + 熔断（持续失败快速降级）
RETRY_ATTEMPTS=3
RETRY_MULTIPLIER=0.5
RETRY_MAX_WAIT=4.0
CIRCUIT_FAILURE_THRESHOLD=5        # 连续失败 N 次开路
CIRCUIT_COOLDOWN=30.0              # 开路冷却秒数
CIRCUIT_SUCCESS_THRESHOLD=1
# DB 连接池 + 慢查询
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30.0
DB_SLOW_QUERY_SECONDS=5.0          # 0=关闭慢查询日志

# ===== 安全合规（设计书 §8） =====
# 接入阶段 PII 脱敏（手机/邮箱/身份证/银行卡）
PII_MASKING_ENABLED=false
PII_RULES=phone,email,idcard,bank
