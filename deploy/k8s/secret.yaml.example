# 复制为 secret.yaml 并填入真实值后：kubectl apply -f secret.yaml
# （secret.yaml 已在 .gitignore，勿提交真实密钥）
apiVersion: v1
kind: Secret
metadata:
  name: rag-secret
  namespace: enterprise-rag
type: Opaque
stringData:
  POSTGRES_USER: "rag"
  POSTGRES_PASSWORD: "CHANGE_ME"
  DATABASE_URL: "postgresql+asyncpg://rag:CHANGE_ME@postgres.enterprise-rag.svc.cluster.local:5432/rag"
  LLM_API_KEY: "CHANGE_ME"
  EMBEDDING_API_KEY: "CHANGE_ME"
  RERANK_API_KEY: ""
  OPENSEARCH_USER: "admin"
  OPENSEARCH_PASSWORD: "CHANGE_ME"
  MINIO_ACCESS_KEY: "CHANGE_ME"
  MINIO_SECRET_KEY: "CHANGE_ME"
